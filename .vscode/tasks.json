{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "运行当前文件（met 环境）",
            "type": "shell",
            "command": "D:\\app\\miniforge\\Scripts\\conda.exe",
            "args": [
                "run",
                "-n",
                "met",
                "--no-capture-output",
                "python",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "跑测试（pytest）",
            "type": "shell",
            "command": "D:\\app\\miniforge\\Scripts\\conda.exe",
            "args": [
                "run",
                "-n",
                "met",
                "--no-capture-output",
                "python",
                "-m",
                "pytest",
                "-q"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
